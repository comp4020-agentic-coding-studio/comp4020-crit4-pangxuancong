---
import Layout from "../layouts/Layout.astro";
import Chrome from "../components/Chrome";
---

<Layout
  title="FLUID"
  description="Touch and sculpt sound inside a living fluid field. No controls — press, drag, or hold to play it with a mouse, a keyboard, or your fingers."
>
  <main>
    <canvas
      id="stage"
      role="application"
      aria-describedby="how"
      aria-label="FLUID, a fluid audiovisual instrument. Press or drag anywhere to sculpt sound; higher up is brighter, further right is a higher pitch, and holding longer sustains the tone."
    ></canvas>
    <canvas id="sparkles" aria-hidden="true"></canvas>
  </main>

  <Chrome client:load />

  <p id="how" class="sr-only">
    Press or drag anywhere on the field to play. Position up and down sets
    brightness, left to right sets pitch, and how long you hold sets how long
    the note sustains. The keys A through K play the scale; hold a key to
    sustain it, and the arrow keys adjust its brightness.
  </p>

  <script src="../scripts/main.ts"></script>
</Layout>
